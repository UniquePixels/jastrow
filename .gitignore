Thumbs.db
node_modules/
.claude/settings.local.json
.worktrees/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# sefaria dump cache (pipeline/fetch.ts)
.cache/

# regenerable pipeline intermediates (data-architecture spec D2).
# Five of these no longer have a live writer — the tool that produced
# them was archived at `refs/tags/archive/v2-research-2026-09` in the
# 2026-09 pipeline consolidation, so they cannot be regenerated. Kept
# ignored anyway (a stale ignore is harmless; untracking them risks
# committing a leftover local copy):
#   - data/sources/sefaria/baseline-audit-report.json (baseline-audit tool)
#   - data/sources/sefaria/body-census-report.json (`body:census`)
#   - data/sources/sefaria/body-migration-report.json (`migrate-dry.ts`)
#   - .usage-mark (`admin/pipeline/research/usage-report.ts --mark`)
#   - .work/ (the page-index build tool)
# data/sources/sefaria/migration-report.json is ignored for the same reason: it
# is the import report's name before the R8 rename (2026-10-02).
data/sources/sefaria/edit-replay.jsonl
data/sources/sefaria/baseline-audit-report.json
data/sources/sefaria/body-census-report.json
data/sources/sefaria/body-dryrun-report.json
data/sources/sefaria/body-migration-report.json
data/sources/sefaria/migration-report.json
data/sources/sefaria/import-report.json

# The same orphans after the 2026-09-22 module-boundary sweep moved
# them out of the pipeline's input directory. Kept on disk for the
# record, out of the index: 108 MB between them, and nothing
# regenerates them. See that directory's README (which IS tracked).
docs/archive/source-reports-2026-09-22/*.json
docs/archive/source-reports-2026-09-22/*.jsonl
.superpowers/
~$*.docx

# no-longer-regenerable: usage-report.ts was archived at
# refs/tags/archive/v2-research-2026-09
.usage-mark

# local scratch for the page-index build (large IA downloads); the
# build tool was archived at refs/tags/archive/v2-research-2026-09,
# so this is also no longer regenerable
.work/

.$*.bkp
