# Cloudflare Pages Security Headers
# https://developers.cloudflare.com/pages/platform/headers/

# Apply security headers to all routes
#
# CSP notes:
# - script-src uses sha256 hashes for the two inline <script> blocks in
#   index.html (JSON-LD metadata + the main bootstrap script) instead of
#   'unsafe-inline'. The site is static (Cloudflare Pages), so per-request
#   nonces are not possible; hashes are the static-host equivalent. If you
#   edit either inline script, recompute its hash (sha256, base64) and
#   update the value below, or the script will be blocked.
# - style-src must keep 'unsafe-inline'. index.html uses 37 inline style=
#   attributes, and Web Awesome / Font Awesome inject styles at runtime.
#   Hashes do not cover inline style attributes (that needs 'unsafe-hashes'
#   plus a hash for every distinct attribute value), so 'unsafe-inline'
#   stays here by necessity.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qVcwwO40F0Igm+ai1JFLmnm4zy1O5VsNrkA+tonYz2g=' 'sha256-1xL8AtzGmIX5hzI71OasgLVWNxxJBo2jH5TGmSv1Vk0=' https://cdn.jsdelivr.net https://kit.webawesome.com https://ka-p.webawesome.com https://kit.fontawesome.com https://ka-p.fontawesome.com https://static.cloudflareinsights.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://ka-p.webawesome.com https://fonts.googleapis.com https://unpkg.com; img-src 'self' data: https://ia600802.us.archive.org https://*.us.archive.org; font-src 'self' data: https://fonts.gstatic.com https://ka-p.webawesome.com https://ka-p.fontawesome.com; connect-src 'self' data: https://ka-p.fontawesome.com https://ka-p.webawesome.com; frame-src https://iiif.archive.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope()
  X-XSS-Protection: 1; mode=block

# Cache JSONL data files aggressively (immutable content)
/data/jastrow-part1.jsonl
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/data/jastrow-part2.jsonl
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Cache bundled JavaScript assets
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS assets
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache images
/assets/images/*
  Cache-Control: public, max-age=86400

# HTML files: short cache, must revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Root index
/
  Cache-Control: public, max-age=3600, must-revalidate
