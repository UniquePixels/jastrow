{"_id":{"$oid":"5c4670aa08d98a02694c53b8"},"headword":"א","parent_lexicon":"Jastrow Dictionary","rid":"A00000","refs":[],"content":{"senses":[{"definition":"<i>Aleph</i>, the first letter of the alphabet, interchanging with other gutturals, e.g. <span dir=\"rtl\">אבב</span>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הָבַב.1\" data-ref=\"Jastrow, הָבַב 1\">הבב</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חָבַב I.1\" data-ref=\"Jastrow, חָבַב I 1\">חבב</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עָבַב.1\" data-ref=\"Jastrow, עָבַב 1\">עבב</a>; <span dir=\"rtl\">אליתא</span>, <span dir=\"rtl\">עליתא</span> &c."}]},"quotes":[],"next_hw":"א ²"}
