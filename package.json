{
	"name": "jastrow",
	"private": true,
	"description": "A progressive web app for browsing and searching Marcus Jastrow's *Dictionary of the Targumim, the Talmud Babli and Yerushalmi, and the Midrashic Literature* (1903).",
	"type": "module",
	"scripts": {
		"audit:corpus": "bash admin/pipeline/audit-corpus.sh",
		"body:census": "bun admin/pipeline/body/census.ts",
		"body:dry-run": "bun admin/pipeline/body/dry-run.ts",
		"body:implied-one-census": "bun admin/pipeline/body/implied-one-census.ts",
		"body:migrate-dry": "bun admin/pipeline/body/migrate-dry.ts",
		"body:review": "bun admin/pipeline/body/review.ts",
		"pageindex:build": "bun admin/pipeline/page-index/build.ts",
		"pageindex:verify": "bun admin/pipeline/page-index/verify.ts",
		"patch:seed-implied-one": "bun admin/pipeline/patch/seed-implied-one.ts",
		"pipeline:fetch": "bun admin/pipeline/fetch.ts",
		"pipeline:migrate": "bun admin/pipeline/migrate.ts",
		"provenance:audit": "bun admin/pipeline/provenance/audit.ts",
		"provenance:baseline": "bun admin/pipeline/provenance/baseline-audit.ts",
		"provenance:mine": "bun admin/pipeline/provenance/mine.ts",
		"qa": "bun qa:format && bun qa:lint && bun qa:test && bun qa:tsc",
		"qa:ci": "biome ci --error-on-warnings",
		"qa:format": "biome format --write",
		"qa:lint": "biome check --error-on-warnings",
		"qa:test": "bun test --path-ignore-patterns='**/*.corpus.test.ts'",
		"qa:tsc": "tsc --noEmit --skipLibCheck",
		"research:apply": "bun admin/pipeline/patch/apply.ts",
		"research:residue": "bun admin/pipeline/research/residue.ts",
		"transform:count": "bun admin/pipeline/transform/count.ts",
		"usage": "bun admin/pipeline/research/usage-report.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@types/bun": "^1.3.14",
		"ajv": "^8.20.0",
		"bson": "^6",
		"htmlparser2": "^12.0.0",
		"typescript": "^6.0.3"
	}
}
