{
	"name": "jastrow",
	"private": true,
	"description": "A progressive web app for browsing and searching Marcus Jastrow's *Dictionary of the Targumim, the Talmud Babli and Yerushalmi, and the Midrashic Literature* (1903).",
	"type": "module",
	"scripts": {
		"data:fetch": "bun run rebuild:fetch",
		"data:import": "bun admin/pipeline/import.ts --write",
		"data:import:dry": "bun admin/pipeline/import.ts",
		"data:sefaria": "bun admin/pipeline/sefaria.ts",
		"data:validate": "bun admin/entry/validate-cli.ts",
		"docs:links": "bun scripts/check-links.ts",
		"qa": "bun qa:format && bun qa:lint && bun qa:test && bun qa:tsc && bun schema:check && bun docs:links",
		"qa:ci": "biome ci --error-on-warnings",
		"qa:format": "biome format --write",
		"qa:lint": "biome check --error-on-warnings",
		"qa:test": "bun test --path-ignore-patterns='**/*.corpus.test.ts'",
		"qa:tsc": "tsc --noEmit --skipLibCheck",
		"rebuild:count": "bun admin/pipeline/transform/count.ts",
		"rebuild:fetch": "bun admin/pipeline/fetch.ts",
		"rebuild:invariants": "bun test admin/pipeline/transform/commutation.corpus.test.ts admin/pipeline/transform/registry.order.corpus.test.ts",
		"schema:build": "bun admin/entry/schema-build.ts",
		"schema:check": "bun admin/entry/schema-build.ts --check",
		"transform:count": "bun run rebuild:count",
		"transform:invariants": "bun run rebuild:invariants"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.3",
		"bson": "^7.3.3",
		"typebox": "1.4.3",
		"typescript": "^7.0.2"
	}
}
