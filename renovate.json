{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":dependencyDashboard",
		":semanticCommitsDisabled",
		"helpers:pinGitHubActionDigests"
	],
	"timezone": "America/New_York",
	"schedule": ["before 6am on monday"],
	"labels": ["dependencies"],
	"rangeStrategy": "bump",
	"lockFileMaintenance": { "enabled": true },
	"packageRules": [
		{
			"description": "Group + automerge SHA-pinned GitHub Actions digest updates",
			"matchManagers": ["github-actions"],
			"groupName": "github-actions",
			"automerge": true,
			"automergeType": "pr"
		},
		{
			"description": "Group mise toolchain (biome, bun) updates",
			"matchManagers": ["mise"],
			"groupName": "mise toolchain"
		},
		{
			"description": "Automerge safe root devDependency minor/patch updates",
			"matchManagers": ["npm"],
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"automerge": true,
			"automergeType": "pr"
		}
	]
}
